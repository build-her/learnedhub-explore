# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email (Resend)
RESEND_API_KEY=re_your_api_key
CONTACT_RECIPIENT_EMAIL=info.learnedhub@gmail.com

# Rate limiting
RATE_LIMIT_SALT=your-random-rate-limit-salt

# Owner / Admin Authentication (server-only, no NEXT_PUBLIC prefix)
ADMIN_PASSCODE=your-secure-admin-passcode
ADMIN_SESSION_SECRET=your-32-character-minimum-secret-key-for-admin-sessions

